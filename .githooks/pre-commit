#!/bin/bash

# Pre-commit hook for @lightweight-charts-pro/core
# Runs ESLint, TypeScript type checking, and Prettier formatting

set -e

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if npm is available
if ! command -v npm &> /dev/null; then
    echo -e "${RED}✗ npm is not installed${NC}"
    exit 1
fi

# Get list of staged TypeScript files
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' || true)

if [ -z "$STAGED_TS_FILES" ]; then
    echo -e "${GREEN}✓ No TypeScript files to check${NC}"
    exit 0
fi

echo -e "${YELLOW}📝 Checking TypeScript files:${NC}"
echo "$STAGED_TS_FILES"

# Run TypeScript type check
echo ""
echo -e "${YELLOW}1️⃣  Running TypeScript type check...${NC}"
if npm run type-check; then
    echo -e "${GREEN}✓ TypeScript type check passed${NC}"
else
    echo -e "${RED}✗ TypeScript type check failed${NC}"
    echo "Fix type errors before committing."
    exit 1
fi

# Run ESLint
echo ""
echo -e "${YELLOW}2️⃣  Running ESLint...${NC}"
if npm run lint; then
    echo -e "${GREEN}✓ ESLint passed${NC}"
else
    echo -e "${RED}✗ ESLint failed${NC}"
    echo "Fix linting errors before committing."
    exit 1
fi

# Run Prettier
echo ""
echo -e "${YELLOW}3️⃣  Running Prettier...${NC}"
if npm run format; then
    echo -e "${GREEN}✓ Prettier formatting applied${NC}"
else
    echo -e "${RED}✗ Prettier formatting failed${NC}"
    exit 1
fi

# Add formatted files back to staging
echo ""
echo -e "${YELLOW}📦 Re-staging formatted files...${NC}"
echo "$STAGED_TS_FILES" | xargs git add

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0
