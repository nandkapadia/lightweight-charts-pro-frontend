{
  "name": "@nandkapadia/lightweight-charts-pro-core",
  "version": "0.1.1",
  "description": "Framework-agnostic core library for TradingView Lightweight Charts Pro",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "require": "./dist/primitives/index.cjs"
    },
    "./series": {
      "types": "./dist/series/index.d.ts",
      "import": "./dist/series/index.js",
      "require": "./dist/series/index.cjs"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./dist/services/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Nand Kapadia",
    "email": "nand.kapadia@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandkapadia/lightweight-charts-pro-frontend.git"
  },
  "homepage": "https://github.com/nandkapadia/lightweight-charts-pro-frontend#readme",
  "bugs": {
    "url": "https://github.com/nandkapadia/lightweight-charts-pro-frontend/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lightweight-charts",
    "tradingview",
    "charts",
    "financial",
    "trading",
    "typescript",
    "framework-agnostic"
  ],
  "peerDependencies": {
    "lightweight-charts": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "jsdom": "^27.0.0",
    "lightweight-charts": "^5.0.8",
    "prettier": "^3.7.4",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs": "typedoc",
    "docs:serve": "npx http-server docs -p 8080",
    "prepare": "bash .githooks/install.sh || true"
  }
}
